<?xml version="1.0"?>
<package format="3">
  <name>rammp_odom3d</name>
  <version>0.1.0</version>
  <description>World-anchored object tracking: stable instance ids and camera-rate boxes from any detector's
    ObjectDetections, aligned depth and odometry (TF).</description>
  <maintainer email="prajapati.s@northeastern.edu">Sarvesh Prajapati</maintainer>
  <license>Proprietary</license>
  <exec_depend>rclpy</exec_depend>
  <exec_depend>rammp_perception_interfaces</exec_depend>
  <exec_depend>sensor_msgs</exec_depend>
  <exec_depend>geometry_msgs</exec_depend>
  <exec_depend>visualization_msgs</exec_depend>
  <exec_depend>tf2_ros</exec_depend>
  <exec_depend>python3-numpy</exec_depend>
  <exec_depend>python3-scipy</exec_depend>
  <test_depend>python3-pytest</test_depend>
  <export><build_type>ament_python</build_type></export>
</package>
